# Copy this file to .env (not .env.local) — prisma.config.ts loads DATABASE_URL from .env via
# `dotenv/config`, and Next.js reads .env too, so this single file covers both the app and the CLI.
# Fill these in once the Supabase project exists (see PLANO.md, section 9).

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Database -> Connection string (Transaction pooler URI, port 6543 —
# required for serverless/Vercel runtime queries)
DATABASE_URL=
# Same page, Session pooler URI (port 5432) — used only by `prisma migrate` / `prisma db seed`,
# which need session-level features the Transaction pooler doesn't support.
DIRECT_URL=

# Stripe (Fase 3 — Carteira)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Fapshi (Fase 6 — Carteira, Mobile Money MTN/Orange, Camarões)
# apiuser/apikey from the Fapshi dashboard. FAPSHI_ENV controls which host is
# used (sandbox.fapshi.com vs live.fapshi.com) — see src/lib/fapshi.ts.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Set on the Fapshi dashboard (per-service webhook config, not via API) —
# compared against the x-wh-secret header on incoming webhooks.
FAPSHI_WEBHOOK_SECRET=
FAPSHI_ENV=sandbox

# Cron auth (see vercel.json + src/app/api/cron/sync-fapshi-deposits/route.ts).
# Any random string -- Vercel Cron sends it automatically as
# "Authorization: Bearer <value>" once set here and on Vercel.
CRON_SECRET=
