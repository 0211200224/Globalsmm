// Prisma schema — GlobalSMM
// See PLANO.md (section 4) for the business rationale behind this model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  /// Legacy — orders created before the admin-approval queue existed. New
  /// orders start at PENDING_ADMIN instead (see src/lib/order-core.ts).
  PENDING
  /// Awaiting admin review in the fulfillment approval queue — the order
  /// was paid for but not yet sent to any provider (see PLANO.md and
  /// src/components/admin/PendingApprovalQueue.tsx).
  PENDING_ADMIN
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  DEBIT
  REFUND
  COMMISSION_PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CommissionStatus {
  /// Order hasn't completed yet — doesn't count toward the withdrawable balance.
  PENDING
  /// Order completed successfully — counts toward the withdrawable balance.
  AVAILABLE
  /// Paid out via a ReferralWithdrawal.
  PAID
  /// Order was canceled/refunded — this commission never materializes.
  VOID
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  ORDER_STATUS
  SUPPORT_REPLY
  REFERRAL_COMMISSION
  WITHDRAWAL_STATUS
  WALLET_DEPOSIT
  SYSTEM
}

enum OrderSource {
  WEB
  API
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  role       UserRole @default(USER)
  tier       String   @default("standard")
  /// Admin-set. Blocked users are denied access at login (see proxy.ts / auth checks).
  blocked    Boolean  @default(false)
  /// Admin-set. Grants the reseller discount rate (see src/lib/vip.ts) —
  /// independent of the VIP spend-tier system.
  isReseller Boolean  @default(false)
  /// Self-service, generated on first visit to /api. Null until then.
  apiKey     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wallet           Wallet?
  orders           Order[]
  affiliateProfile AffiliateProfile?
  referralsMade    AffiliateReferral[] @relation("ReferrerUser")
  referredBy       AffiliateReferral?  @relation("ReferredUser")
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  notifications    Notification[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(cuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(12, 2)
  method      String            @default("stripe")
  externalRef String?
  createdAt   DateTime          @default(now())
}

/// An upstream SMM fulfillment provider (see PLANO.md section 6 — the
/// standard-shaped `action=services|add|status|refill|cancel|balance` API
/// most fornecedores expose). Semi-automatic for now: orders never dispatch
/// here on their own, only when an admin approves them in the queue.
model Provider {
  id        String    @id @default(cuid())
  name      String
  apiUrl    String
  apiKey    String
  /// Cached from the provider's own balance endpoint — refreshed on demand
  /// (see syncProviderBalance in src/lib/actions/admin-providers.ts), not
  /// polled automatically yet.
  balance   Decimal?  @db.Decimal(12, 2)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  services Service[]
  orders   Order[]
}

model ServiceCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  icon   String?
  /// Display order in the platform picker (lower = first).
  sortOrder Int  @default(0)

  services Service[]
}

model Service {
  id           String          @id @default(cuid())
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  /// Cross-platform service type for the "browse by type" filter, e.g.
  /// "Followers", "Likes", "Views", "Members", "Reactions"... Free-form
  /// string on purpose (see PLANO.md 10.13 — new types must not need a
  /// migration).
  serviceType  String
  name         String
  description  String?
  /// Material Symbols icon name.
  icon         String          @default("bolt")
  /// Optional highlight badge shown on the service card ("Hot", "Stable", "Elite").
  badge        String?
  /// Human-readable delivery speed shown on the service card, e.g. "Instant", "10m / 1k".
  speedLabel   String          @default("Standard")
  pricePer1000 Decimal         @db.Decimal(10, 4)
  minQuantity  Int
  maxQuantity  Int
  /// Out of 10, one decimal (e.g. 9.4). Null = not rated yet, hidden on the card.
  qualityScore    Decimal? @db.Decimal(3, 1)
  /// 0-100. Null = not measured yet, hidden on the card.
  retentionPercent Int?
  /// Refill guarantee window in days from order creation. 0 = no guarantee
  /// (no refill request allowed for orders of this service).
  refillDays       Int      @default(0)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())

  /// Default provider used to fulfill orders of this service — null means
  /// still fully manual (admin approval just moves the order to PROCESSING
  /// without calling any provider API). The admin can still override the
  /// provider per-order at approval time (see Order.providerId).
  providerId        String?
  provider          Provider? @relation(fields: [providerId], references: [id])
  /// This service's id in the provider's own catalog — required to call
  /// their `add`/`status`/`refill`/`cancel` actions.
  externalServiceId String?
  /// What the provider charges per 1000 units — shown to the admin next to
  /// pricePer1000 (what the customer pays) in the approval queue, purely
  /// informational (no margin enforcement).
  costPer1000       Decimal?  @db.Decimal(10, 4)

  orders Order[]

  @@index([serviceType])
}

model Order {
  id                String      @id @default(cuid())
  /// Short sequential number for the human-facing "#GS-xxxxx" order ID.
  orderNumber       Int         @default(autoincrement()) @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  serviceId         String
  service           Service     @relation(fields: [serviceId], references: [id])
  quantity          Int
  /// How much of `quantity` has been delivered so far — drives the progress bar.
  deliveredQuantity Int         @default(0)
  targetLink        String
  chargedAmount     Decimal     @db.Decimal(12, 2)
  status            OrderStatus @default(PENDING_ADMIN)
  /// WEB = placed through the dashboard, API = placed by a reseller via /api/v2.
  source            OrderSource @default(WEB)
  adminNote         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  /// The provider this order was actually dispatched to (set on admin
  /// approval — may differ from service.providerId if the admin picked a
  /// different one in the queue). Null while PENDING_ADMIN or for
  /// manually-fulfilled orders.
  providerId        String?
  provider          Provider?   @relation(fields: [providerId], references: [id])
  /// The order id returned by the provider's `add` action, once dispatched.
  externalOrderId   String?

  referralCommission ReferralCommission?
  supportTickets     SupportTicket[]
  refillRequests     RefillRequest[]

  @@index([userId])
}

model AffiliateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  referralCode   String   @unique
  /// 5% of each qualifying order placed by a referred user (see PLANO.md section 7).
  commissionRate Decimal  @default(0.05) @db.Decimal(4, 2)
  createdAt      DateTime @default(now())

  commissions ReferralCommission[]
  withdrawals ReferralWithdrawal[]
}

model AffiliateReferral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("ReferrerUser", fields: [referrerId], references: [id])
  referredId String   @unique
  referred   User     @relation("ReferredUser", fields: [referredId], references: [id])
  createdAt  DateTime @default(now())
}

model ReferralCommission {
  id          String            @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile  @relation(fields: [affiliateId], references: [id])
  orderId     String            @unique
  order       Order             @relation(fields: [orderId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  status      CommissionStatus  @default(PENDING)
  createdAt   DateTime          @default(now())

  @@index([affiliateId])
}

model ReferralWithdrawal {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id])
  amount      Decimal          @db.Decimal(12, 2)
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([affiliateId])
}

model SupportTicket {
  id           String       @id @default(cuid())
  /// Short sequential number for the human-facing "#GS-T-xxxxx" ticket ID.
  ticketNumber Int          @default(autoincrement()) @unique
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  /// Optional — lets the customer point at exactly which order the issue is about.
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id])
  subject      String
  status       TicketStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  messages SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id])
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  isAdminReply Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())

  @@index([ticketId])
}

/// One auto-approved 30-day refill claim per order — see requestRefill in
/// src/lib/actions/orders.ts. Fulfillment is still manual (see PLANO.md),
/// so "automatic" here means the eligibility check is instant and skips
/// the support-ticket queue, not that redelivery itself is automated.
model RefillRequest {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  /// Optional in-app link the notification should navigate to when clicked.
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
